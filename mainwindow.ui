  <property name="styleSheet">
   <string notr="true">/* Instrument Light palette
   ground   #eef2f5   surface  #ffffff   border  #c8d2da
   ink      #16232e   muted    #5c6f7e   faded   #9fb0bd
   accent   #1264a3
   readout  #0e2029 panel, #59d3e8 commanded, #ffc247 measured
   ok       #1c8a4d   active   #d97706   fault   #c0392b

   Every rule is selector-qualified. An unqualified background-color on
   QMainWindow propagates to every descendant, which is how the readouts
   ended up on the same white as their own digits. */

QMainWindow, QStackedWidget, QWidget#centralwidget, QWidget#ScanPage {
    background-color: #eef2f5;
}

QLabel            { color: #16232e; background: transparent; }
QLabel#lblStatus  { color: #5c6f7e; padding: 2px 4px; }

QPushButton {
    color: #16232e;
    background-color: #ffffff;
    border: 1px solid #c8d2da;
    border-radius: 8px;
    padding: 10px 16px;
}
QPushButton:pressed { background-color: #dbe6ef; border-color: #1264a3; }
/* Without this a disabled control still renders dark, so the operator
   cannot see whether the device is armed. */
QPushButton:disabled {
    color: #9fb0bd;
    background-color: #f3f6f8;
    border-color: #dde4ea;
}

/* The two committing actions carry their meaning in colour, not just text.
   Each needs its own :disabled rule - an id selector outranks the generic
   QPushButton:disabled above, so without these Activate would sit green
   and inviting while the device is not armed. */
QPushButton#activate          { color: #ffffff; background-color: #1c8a4d; border-color: #16713f; }
QPushButton#activate:pressed  { background-color: #14663a; }
QPushButton#activate:disabled { color: #9fb0bd; background-color: #f3f6f8; border-color: #dde4ea; }

QPushButton#abort          { color: #ffffff; background-color: #c0392b; border-color: #9d2f24; }
QPushButton#abort:pressed  { background-color: #9d2f24; }
QPushButton#abort:disabled { color: #9fb0bd; background-color: #f3f6f8; border-color: #dde4ea; }

QListWidget {
    color: #16232e;
    background-color: #ffffff;
    border: 1px solid #c8d2da;
    border-radius: 6px;
    padding: 4px;
}
QListWidget::item          { padding: 8px 6px; }
QListWidget::item:selected { background-color: #1264a3; color: #ffffff; }

/* Dark panel, bright digits - the readouts are the one thing that must stay
   legible under lab lighting. Paired with setSegmentStyle(Flat) in the
   constructor: the default Outline style ignores this colour and draws from
   the palette's light/dark roles instead. */
QLCDNumber {
    background-color: #0e2029;
    color: #59d3e8;
    border: 1px solid #21323d;
    border-radius: 6px;
}
/* Measured, not commanded. Different hue so a divergence between the two
   voltage readouts is visible at a glance rather than read digit by digit. */
QLCDNumber#readvolt { color: #ffc247; }</string>
